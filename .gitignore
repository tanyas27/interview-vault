# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# SQLite local database — NEVER commit this (contains your real data)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime logs — contain server URLs and request traces
dev.log
*.log

# internal architecture docs — don't expose implementation details publicly
IMPLEMENTATION_SUMMARY.md
